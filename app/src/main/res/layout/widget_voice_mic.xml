<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetVoiceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/bg_widget_voice_mic">

    <ImageView
        android:id="@+id/widgetVoiceIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/widget_voice_content_description"
        android:src="@drawable/ic_mic_24"
        android:tint="@android:color/white" />

    <TextView
        android:id="@+id/widgetVoiceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_voice_label"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>

